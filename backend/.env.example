# Server
PORT=4000

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Two engines are supported, and this one line picks which. Its scheme decides the schema file, the
# migration lineage and the Prisma client that gets generated, so there is no second setting to keep
# in sync -- and nothing to edit in prisma/schema.prisma.
#
#   PostgreSQL -- the default. Required for a server install, and the only engine that supports
#   several worker processes writing at once:
#
#     DATABASE_URL="postgresql://<user>:<password>@localhost:5432/quiz_app"
#
#   Percent-encode any special characters in the password (e.g. "@" -> "%40").
#
#   SQLite -- one file, no server to install, fine for a single-user local setup. Everything works,
#   including background generation, but only one process may write at a time:
#
#     DATABASE_URL="file:./dev.db"
#
#   A relative path is resolved against backend/prisma/sqlite/, because that is where the SQLite
#   schema lives and Prisma reads the path relative to the schema. Append "?socket_timeout=20" to
#   wait 20s instead of the default 5s when another process is holding the write lock.
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/quiz_app"

# Which AI provider to use by default. One of: mock | claude | openai
# mock costs nothing and needs no keys -- start here, flip this once your ICA keys are in.
AI_PROVIDER=mock

# Quiz generation cost control
QUIZ_GENERATE_RATE_LIMIT=10

# Real-provider (claude/openai) request resilience -- bounded timeout + SDK-native retry
AI_PROVIDER_TIMEOUT_MS=20000
AI_PROVIDER_MAX_RETRIES=2

# --- Quiz generation (batching) ---
# A quiz is generated as several small independent batches rather than one large call, so a bad
# question costs one small re-request instead of the whole quiz. Attempts are counted per batch.
AI_GENERATION_CONCURRENCY=3
AI_GENERATION_MAX_BATCH_ATTEMPTS=3
# Set to "off" to silence the per-batch [GEN] log lines.
GENERATION_LOG=on

# --- Background generation worker ---
# Drains queued jobs created by POST /api/quiz/generations. Set to false only if you run a
# separate worker process against the same database -- which is a PostgreSQL-only arrangement.
# The job claim itself is safe on both engines, but SQLite allows only one writer at a time, so a
# second worker process would spend its life waiting on the first rather than adding throughput.
GENERATION_WORKER_ENABLED=true
GENERATION_WORKER_POLL_MS=1000
# A job whose worker died is reclaimed once its lease is this stale, then resumes from the
# batches already persisted rather than starting over.
GENERATION_LEASE_MS=120000

# --- Claude, via IBM Consulting Advantage (ICA) ---
# Paste your ICA-issued key below. Base URL/model already point at ICA's gateway.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- GPT, via IBM Consulting Advantage (ICA) ---
# Paste your ICA-issued key below.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica/v1
# An older ICA doc sample showed .../ica/openai instead of .../ica/v1 -- if the
# /v1 path 404s for you, try that path instead.
OPENAI_MODEL=gpt-5.6-terra-dzus

# ---------------------------------------------------------------------------
# Per-user AI configuration (see README "AI Settings")
# ---------------------------------------------------------------------------
# Encrypts each user's AI provider API key at rest (AES-256-GCM). Must decode to
# exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# LOSING THIS MAKES EVERY SAVED API KEY UNREADABLE -- users would have to re-enter them.
ENCRYPTION_KEY=

# Shared code required to create an account. Anyone with the app URL and this code
# can sign up, so treat it as a password and rotate it when you stop testing.
SIGNUP_INVITE_CODE=change-me-before-deploying

# Browser origins allowed to call this API, comma-separated. Exact scheme, no trailing
# slash. Defaults to the local Vite dev server when unset.
#   CORS_ORIGINS=https://my-quiz.onrender.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# How long an issued JWT stays valid. Shorten only once the frontend logs out on 401.
JWT_EXPIRES_IN=7d

# When true, a user with no saved AI config falls back to the ANTHROPIC_*/OPENAI_* keys
# below. Convenient locally; MUST be false in any shared/public deployment, because it is
# what stops two users spending the same key.
AI_ALLOW_ENV_FALLBACK=true

# Per-user explanation requests per hour. Read by config/env.js; previously undocumented.
EXPLAIN_RATE_LIMIT=30

# Set to 1 when running behind a reverse proxy (Render, Fly, nginx) so req.ip is the real client
# rather than the proxy -- see middleware/rateLimit.js and app.js.
TRUST_PROXY=0

# Allows http:// and loopback AI endpoints, for a locally hosted model (Ollama, LM Studio).
# config/env.js REFUSES TO START with this true when NODE_ENV=production: it is the one switch that
# disarms the scheme and loopback checks in validation/aiEndpoint.js.
AI_ALLOW_INSECURE_ENDPOINTS=false

# Test Connection makes a real outbound call to a user-supplied URL, so it has its own small budget.
AI_CONFIG_TEST_RATE_LIMIT=10

# Signup/login attempts per IP per 15 minutes. These are the only unauthenticated endpoints that run
# bcrypt, which makes them the cheapest way to exhaust a small instance's CPU.
AUTH_RATE_LIMIT=20

# ---------------------------------------------------------------------------
# Rotating ENCRYPTION_KEY
# ---------------------------------------------------------------------------
# keyVersion on UserAiConfig plus the "v1." prefix inside the stored ciphertext are the rotation
# seam. A full rotation would be: teach apiKeyCrypto.js to accept ENCRYPTION_KEY_PREVIOUS for
# decryption only, sweep every row (decrypt with the old key, re-encrypt with the new, set
# keyVersion: 2), then drop the previous key once no rows remain at version 1. The key is memoized
# at boot, so each step ends in a restart.
#
# For a handful of users the cheap alternative is entirely reasonable: set the new key and let each
# person re-enter theirs -- which is exactly what the "could not be read, please re-enter it in AI
# Settings" message tells them to do.
