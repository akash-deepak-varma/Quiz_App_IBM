# Server
PORT=4000

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# --- Database ---
# Two engines are supported, and this one line picks which. Its scheme decides the schema file, the
# migration lineage and the Prisma client that gets generated, so there is no second setting to keep
# in sync -- and nothing to edit in prisma/schema.prisma.
#
#   PostgreSQL -- the default. Required for a server install, and the only engine that supports
#   several worker processes writing at once:
#
#     DATABASE_URL="postgresql://<user>:<password>@localhost:5432/quiz_app"
#
#   Percent-encode any special characters in the password (e.g. "@" -> "%40").
#
#   SQLite -- one file, no server to install, fine for a single-user local setup. Everything works,
#   including background generation, but only one process may write at a time:
#
#     DATABASE_URL="file:./dev.db"
#
#   A relative path is resolved against backend/prisma/sqlite/, because that is where the SQLite
#   schema lives and Prisma reads the path relative to the schema. Append "?socket_timeout=20" to
#   wait 20s instead of the default 5s when another process is holding the write lock.
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/quiz_app"

# Which AI provider to use by default. One of: mock | claude | openai
# mock costs nothing and needs no keys -- start here, flip this once your ICA keys are in.
AI_PROVIDER=mock

# Quiz generation cost control
QUIZ_GENERATE_RATE_LIMIT=10

# Real-provider (claude/openai) request resilience -- bounded timeout + SDK-native retry
AI_PROVIDER_TIMEOUT_MS=20000
AI_PROVIDER_MAX_RETRIES=2

# --- Quiz generation (batching) ---
# A quiz is generated as several small independent batches rather than one large call, so a bad
# question costs one small re-request instead of the whole quiz. Attempts are counted per batch.
AI_GENERATION_CONCURRENCY=3
AI_GENERATION_MAX_BATCH_ATTEMPTS=3
# Set to "off" to silence the per-batch [GEN] log lines.
GENERATION_LOG=on

# --- Background generation worker ---
# Drains queued jobs created by POST /api/quiz/generations. Set to false only if you run a
# separate worker process against the same database -- which is a PostgreSQL-only arrangement.
# The job claim itself is safe on both engines, but SQLite allows only one writer at a time, so a
# second worker process would spend its life waiting on the first rather than adding throughput.
GENERATION_WORKER_ENABLED=true
GENERATION_WORKER_POLL_MS=1000
# A job whose worker died is reclaimed once its lease is this stale, then resumes from the
# batches already persisted rather than starting over.
GENERATION_LEASE_MS=120000

# --- Claude, via IBM Consulting Advantage (ICA) ---
# Paste your ICA-issued key below. Base URL/model already point at ICA's gateway.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- GPT, via IBM Consulting Advantage (ICA) ---
# Paste your ICA-issued key below.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.nextgen-beta.ica.ibm.com/ica/v1
# An older ICA doc sample showed .../ica/openai instead of .../ica/v1 -- if the
# /v1 path 404s for you, try that path instead.
OPENAI_MODEL=gpt-5.6-terra-dzus
