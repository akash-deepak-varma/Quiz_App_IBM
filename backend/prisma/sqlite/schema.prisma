  status    String // SUCCEEDED | PARTIAL | FAILED

  failureCategory String?
  failureReason   String?
  durationMs      Int?
  inputTokens     Int?
  outputTokens    Int?

  createdAt DateTime @default(now())

  @@index([generationId])
}

model GeneratedQuestion {
