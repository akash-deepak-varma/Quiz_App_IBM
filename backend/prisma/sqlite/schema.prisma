// --- Quiz generation jobs -------------------------------------------------------------------
// Generation used to live entirely inside one HTTP request: nothing survived a timeout, a crash
// or a partial failure. These three tables are that same work made durable -- the job, one row
// per batch attempt, and the questions staged before the quiz exists.

model QuizGeneration {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // The request, captured verbatim so a resumed job re-plans identically. `topic` is a plain
  // string, not a Topic FK: the Topic row is only created when the quiz materializes, so a job
  // that never succeeds leaves no orphan topic behind.
  topic       String
  notes       String?
  difficulty  String // beginner | intermediate | advanced -- see src/constants/enums.js
  typeMixJson String? // JSON.stringify(string[]); null means "every type"
  tagsJson    String? // JSON.stringify(string[])
  provider    String // mock | claude | openai
  requested   Int

  status      String  @default("PENDING") // PENDING | GENERATING | READY | PARTIAL | FAILED | CANCELLED -- see services/generation/orchestrator.js
  generated   Int     @default(0) // accepted questions so far; what the progress endpoint reports
  attempts    Int     @default(0) // batch attempts run, across retries
  planJson    String? // JSON.stringify(plan) -- what the planner decided, for resume and forensics
  contextMode String? // DIRECT | DISTILLED | RETRIEVAL -- see services/generation/planner.js
  model       String?

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  failureCategory String? // see services/generation/failureCategory.js
  failureReason   String?

  // Lease-based ownership. A worker claims a job with an engine-agnostic compare-and-swap and
  // stamps itself here (see services/generation/worker.js); another worker may reclaim the job once
  // the lease goes stale, which is what makes a crashed worker recoverable rather than a
  // permanently stuck job.
  lockedAt        DateTime?
  lockedBy        String?
  cancelRequested Boolean   @default(false)

  quizId String? @unique
  quiz   Quiz?   @relation(fields: [quizId], references: [id])

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  batches         GenerationBatch[]
  stagedQuestions GeneratedQuestion[]

  @@index([userId])
  @@index([status, createdAt]) // the claim query's WHERE + ORDER BY
}

model GenerationBatch {
  id           String         @id @default(cuid())
  generationId String
  generation   QuizGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  batchKey  String // planner batch id, e.g. "b2", or "b2.r3" for a retry/split unit
  typesJson String // JSON.stringify(string[]) -- the types this unit asked for
  requested Int
  accepted  Int    @default(0)
