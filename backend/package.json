    "openai": "^4.71.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "vitest": "^2.1.4"
  },
  "allowScripts": {
