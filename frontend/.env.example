# Base URL of the backend API, including the /api suffix (src/api/client.js concatenates paths
# straight onto this value).
#
# Vite inlines VITE_* variables AT BUILD TIME -- this is not read at runtime. Changing it for a
# deployed site means rebuilding, not restarting. If it is unset at build time the bundle falls back
# to http://localhost:4000/api, which is the usual cause of a deployed frontend that appears to do
# nothing.
VITE_API_BASE_URL=http://localhost:4000/api
